{
  "name": "amongdemons-website",
  "version": "1.0.0",
  "description": "Simple Express.js website for amongdemons.com",
  "main": "server.js",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node -e \"require('./public/api/lib/schema').initializeSchema().then(() => console.log('Database migrations complete.'))\"",
    "assets:backgrounds": "node scripts/generate-background-variants.js",
    "assets:demon-atlas": "node scripts/generate-demon-map-atlas.js",
    "build:browser": "node scripts/build-browser.js",
    "build": "npm run assets:backgrounds && npm run assets:demon-atlas && npm run build:browser",
    "db:reset-players": "node scripts/reset-player-database.js",
    "simulate:dungeon": "node scripts/simulate-dungeon-balance.js",
    "test": "node --test"
  },
  "dependencies": {
    "bootstrap": "^5.3.2",
    "compression": "^1.8.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "lucide": "^1.16.0",
    "mysql2": "^3.22.3",
    "pixi.js": "^8.19.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "nodemon": "^3.0.2"
  }
}
